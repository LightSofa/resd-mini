#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/resd-mini"
CONF="/etc/config/resd-mini"

start_service() {
    local enabled host port save_dir log_file auto_proxy rule gateway_https

    config_load "resd-mini"
    config_get_bool enabled "main" "enabled" 1
    [ "$enabled" -eq 1 ] || return 0

    config_get host "main" "host" "0.0.0.0"
    config_get port "main" "port" "8899"
    config_get save_dir "main" "save_dir" "/root/downloads/resd-mini"
    config_get log_file "main" "log_file" "/var/log/resd-mini.log"
    config_get_bool auto_proxy "main" "auto_proxy" 1
    config_get rule "main" "rule" ""
    config_get_bool gateway_https "main" "gateway_https" 0

    mkdir -p "$(dirname "$log_file")" "$save_dir"

    procd_open_instance
    procd_set_param command /usr/bin/env "RESD_HOST=$host" "RESD_PORT=$port" "RESD_SAVE_DIR=$save_dir" "RESD_AUTO_PROXY=$auto_proxy" "RESD_RULE=$rule" "RESD_GATEWAY_HTTPS=$gateway_https" "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONF"
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="65535 65535"
    procd_close_instance
}
